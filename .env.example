# Copy to .env and fill in. NEVER commit the real .env.

# development | production  (production refuses to start with a weak JWT_SECRET)
APP_ENV=development

# Required in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# docker-compose / PostgreSQL
POSTGRES_USER=ocr
POSTGRES_PASSWORD=
POSTGRES_DB=ocr

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOW_REGISTRATION=1          # set to 0 once your accounts exist
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Cross-origin access (comma-separated). Empty = same-origin only.
CORS_ORIGINS=

# Limits
MAX_UPLOAD_MB=50
MAX_FILES_PER_JOB=50
MAX_PDF_PAGES=300
MAX_CONCURRENT_JOBS=2

# Optional build-time corporate proxy
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
